{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch",
            "type": "cppvsdbg",
            "preLaunchTask": "CMake: build",
            "request": "launch",
            "program": "${workspaceFolder}/build/driver_sim/driver_sim.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "internalConsole"
        },
        {
            "name": "Launch (RenderDoc Capture)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "CMake: build",
            "program": "/usr/bin/env",
            "args": [
                "bash",
                "${workspaceFolder}/scripts/renderdoc_capture.sh",
                "${workspaceFolder}/build/driver_sim/driver_sim"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "windows": {
                "program": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\renderdoc_capture.ps1",
                    "-ExePath",
                    "${workspaceFolder}\\build\\driver_sim\\driver_sim.exe"
                ]
            }
        }
    ]
}